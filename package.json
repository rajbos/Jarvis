{
  "name": "jarvis",
  "version": "0.1.6",
  "description": "Jarvis — a locally-hosted personal assistant agent for GitHub repository maintenance",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc && node scripts/build-renderer.mjs && npm run copy-static",
    "copy-static": "node -e \"const fs=require('fs');const p=require('path');fs.mkdirSync('dist/renderer',{recursive:true});for(const f of fs.readdirSync('src/renderer')){if(f.endsWith('.html'))fs.cpSync(p.join('src/renderer',f),p.join('dist/renderer',f));}\"",
    "prestart": "node scripts/ensure-electron.mjs",
    "start": "npm run build && electron dist/main/index.js",
    "pack:win": "npm run build && electron-builder --win --dir",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "publish:win": "npm run build && electron-builder --win nsis --publish always",
    "dev:tsc": "tsc --watch --preserveWatchOutput",
    "dev:esbuild": "node scripts/build-renderer.mjs --watch",
    "dev:electron": "node scripts/ensure-electron.mjs && node scripts/watch-electron.mjs",
    "predev": "node scripts/ensure-electron.mjs",
    "dev": "npm run build && concurrently --kill-others --names \"TSC,ESBuild,Electron\" --prefix-colors \"blue,yellow,green\" \"npm run dev:tsc\" \"npm run dev:esbuild\" \"npm run dev:electron\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test:coverage": "vitest run --coverage",
    "build:mcp": "tsc --project tsconfig.json && echo MCP server built",
    "mcp": "npm run build:mcp && node dist/mcp-server/index.js"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@joplin/onenote-converter": "^3.7.1",
    "@types/node": "^26.6.2",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^5.0.1",
    "concurrently": "^10.0.5",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-reloader": "^1.2.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "nodemon": "^3.1.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^6.8.9",
    "octokit": "^5.0.5",
    "preact": "^10.29.8",
    "sql.js": "^1.14.2",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "allowScripts": {
    "electron": true,
    "electron-winstaller": true,
    "esbuild": true
  }
}
