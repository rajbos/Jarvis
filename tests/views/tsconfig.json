{
  // Type-checks the headless view tests and their fake window.jarvis against the
  // real JarvisApi, so a new preload method fails `npm run test:views` until the
  // fake gets a default response.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vitest/globals"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "noEmit": true
  },
  "include": ["./**/*.ts", "../../src/types/**/*.d.ts"]
}
